+
+/* =========================
+   Per-question table previews
+   ========================= */
+
+.question-tables {
+  display: block;
+  width: 100%;
+  margin: 17px 0 2px;
+  border: 1px solid #d9e2ec;
+  background: #f8fafc;
+  border-radius: 9px;
+  overflow: hidden;
+}
+
+.question-tables summary {
+  padding: 10px 12px;
+  cursor: pointer;
+  font-weight: 780;
+  color: #334155;
+  list-style-position: inside;
+}
+
+.question-tables[open] summary {
+  border-bottom: 1px solid #d9e2ec;
+}
+
+.question-table-grid {
+  display: grid;
+  grid-template-columns: repeat(3, minmax(0, 1fr));
+  gap: 12px;
+  padding: 12px;
+  align-items: start;
+}
+
+.question-table-card {
+  min-width: 0;
+  border: 1px solid #dfe5ec;
+  border-radius: 9px;
+  background: #ffffff;
+  overflow: hidden;
+}
+
+.question-table-title {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 10px;
+  padding: 9px 10px;
+  border-bottom: 1px solid #e5e9ef;
+  background: #f8fafc;
+}
+
+.question-table-title strong {
+  font-size: 13px;
+  color: #1f2937;
+}
+
+.question-table-title span {
+  flex: 0 0 auto;
+  font-size: 10px;
+  color: #64748b;
+}
+
+.question-table-scroll {
+  width: 100%;
+  max-height: 280px;
+  overflow: auto;
+  scrollbar-width: thin;
+  scrollbar-color: #aab2bd transparent;
+}
+
+.question-table-scroll table {
+  width: max-content;
+  min-width: 100%;
+  border-collapse: collapse;
+  font-size: 11px;
+}
+
+.question-table-scroll th,
+.question-table-scroll td {
+  padding: 7px 8px;
+  border-bottom: 1px solid #edf0f3;
+  border-right: 1px solid #edf0f3;
+  text-align: left;
+  white-space: nowrap;
+}
+
+.question-table-scroll th {
+  position: sticky;
+  top: 0;
+  z-index: 1;
+  background: #eef2f6;
+  color: #334155;
+  font-weight: 800;
+}
+
+.question-table-scroll td {
+  color: #475569;
+}
+
+.question-table-scroll em {
+  color: #8b5e00;
+  font-style: italic;
+}
+
+.question-table-empty {
+  grid-column: 1 / -1;
+  padding: 12px;
+  border: 1px dashed #cbd5e1;
+  border-radius: 8px;
+  color: #64748b;
+  background: #ffffff;
+  font-size: 12px;
+}
+
+.question-table-scroll::-webkit-scrollbar {
+  width: 8px;
+  height: 8px;
+}
+
+.question-table-scroll::-webkit-scrollbar-thumb {
+  background: #aab2bd;
+  border-radius: 999px;
+}
+
+@media (max-width: 1100px) {
+  .question-table-grid {
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+  }
+}
+
+@media (max-width: 700px) {
+  .question-table-grid {
+    grid-template-columns: 1fr;
+  }
+
+  .question-table-scroll {
+    max-height: 240px;
+  }
+}
+
